# --- Azure DevOps / Artifacts ---
AZURE_ORG=your-organization-name
# Project GUID (most reliable for REST APIs)
AZURE_PROJECT=00000000-0000-0000-0000-000000000000
# Human-readable project name (used for Azure DevOps UI URLs, e.g. "My Project" becomes "My%20Project")
AZURE_PROJECT_NAME=Your Project Name
AZURE_FEED_NAME=YourFeedName
# Base UI URL; if left empty, dynamically constructed as https://{AZURE_ORG}.visualstudio.com/{AZURE_PROJECT_NAME}
AZURE_DEVOPS_UI_BASE=
AZURE_API_VERSION=7.1-preview.1
# Personal Access Token with Packaging (read / read+write) scope.
# DO NOT commit a real value — keep it only in your local .env.
AZURE_PAT=

# --- PyPI ---
PYPI_JSON_BASE=https://pypi.org/pypi
PYPI_PROJECT_BASE=https://pypi.org/project

# --- Defaults ---
DEFAULT_PYTHON_TAG=cp312
DEFAULT_DOWNLOAD_DIR=./wheels
REQUEST_TIMEOUT=60
UPLOAD_TIMEOUT=600
